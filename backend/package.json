{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./src/index.ts",
    "dev": "npm run build && tsx --env-file=.env --watch ./src/index.ts",
    "db:check": "npx tsx ./src/db/check-connection.ts",
    "db:init": "npx drizzle-kit push --config=./src/db/drizzle.config.ts && npx tsx ./src/db/seed.ts",
    "db:studio": "npx drizzle-kit studio --config=./src/db/drizzle.config.ts",
    "db:migrate": "npx drizzle-kit push --config=./src/db/drizzle.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@zod/zod": "npm:@jsr/zod__zod@^4.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "pg": "^8.20.0"
  }
}
